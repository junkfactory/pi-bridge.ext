{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"files": {
		"includes": ["**/src/**", "**/tests/**"]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"linter": {
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["**/tests/**/*.ts", "**/tests/**/*.tsx"],
			"linter": {
				"rules": {
					"suspicious": {
							"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
